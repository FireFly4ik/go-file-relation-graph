<idea-plugin>
    <id>dev.firefly4ik.go-file-relation-graph</id>
    <name>Go File Relation Graph</name>
    <vendor>firefly4ik</vendor>

    <description><![CDATA[
        Visualizes calls and interface implementations between Go files. Build a live graph for open files,
        or create a snapshot graph of possible project callers for the Go function or method under the caret.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.go</depends>
    <depends>com.intellij.modules.goland</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
            id="Go File Relation Graph"
            displayType="BALLOON"
            isLogByDefault="true"/>
        <toolWindow
            id="Go File Relation Graph"
            anchor="bottom"
            secondary="true"
            icon="/icons/toolWindow.svg"
            factoryClass="dev.firefly4ik.gofilerelationgraph.ui.GoFileRelationGraphToolWindowFactory"/>
    </extensions>

    <actions>
        <action
            id="dev.firefly4ik.gofilerelationgraph.BuildParentGraph"
            class="dev.firefly4ik.gofilerelationgraph.actions.BuildParentGraphAction"
            icon="/icons/toolWindow.svg"
            text="Build Parent Graph"
            description="Build a graph of project functions that can call the function under the caret">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
